{
  "name": "scamshield",
  "version": "1.0.0",
  "private": true,
  "description": "ScamShield — production-ready Chrome extension for scam and phishing website detection with a Node.js + Express AI backend.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:extension": "pnpm --filter @scamshield/extension dev",
    "dev:server": "pnpm --filter @scamshield/server dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean"
  }
}
