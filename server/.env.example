# =============================================================================
# ScamShield API — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in your values. `.env` is gitignored —
# never commit real API keys.
#
# The AI layer speaks the OpenAI Chat Completions protocol, so it works with
# OpenRouter, OpenAI, or ANY OpenAI-compatible endpoint (Groq, Together,
# Mistral, Ollama, LM Studio, vLLM, LiteLLM...) with zero code changes.
# =============================================================================

# --- Server -----------------------------------------------------------------
PORT=8787
NODE_ENV=production

# --- AI provider ------------------------------------------------------------
# AI_PROVIDER: "openrouter" (default) | "openai" | "custom"
#
#   openrouter  -> https://openrouter.ai/api/v1   (one key, hundreds of models)
#   openai      -> https://api.openai.com/v1
#   custom      -> any OpenAI-compatible URL; you MUST set AI_BASE_URL
#
# AI_BASE_URL overrides the preset's base URL for any provider.
# AI_MODEL    overrides the preset's default model.
AI_PROVIDER=openrouter

# Your provider API key. For OpenRouter get one at:
#   https://openrouter.ai/keys
AI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model to use. Free OpenRouter models end in ":free", e.g.:
#   nvidia/nemotron-3.5-lightning:free
#   z-ai/glm-5.2:free
#   google/gemma-4-31b-it:free
# Browse all models: https://openrouter.ai/models?q=free
AI_MODEL=nvidia/nemotron-3.5-lightning:free

# --- Example: switch to plain OpenAI ----------------------------------------
# AI_PROVIDER=openai
# AI_API_KEY=sk-proj-...
# AI_MODEL=gpt-4o-mini

# --- Example: any other OpenAI-compatible endpoint --------------------------
# AI_PROVIDER=custom
# AI_BASE_URL=https://api.groq.com/openai/v1     # or Together, Mistral, Ollama...
# AI_API_KEY=gsk_...
# AI_MODEL=llama-3.1-70b-versatile

# --- CORS / extension origin allowlist --------------------------------------
# Comma-separated list of origins allowed to call the API.
ALLOWED_EXTENSION_ORIGINS=chrome-extension://<your-extension-id>

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MINUTES=15
