# =============================================================================
# ScamShield API — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in your values. `.env` is gitignored —
# never commit real API keys.
#
# The server uses Groq only. The key never ships to the Chrome extension.
# =============================================================================

# --- Server -----------------------------------------------------------------
PORT=8787
NODE_ENV=production

# --- Groq AI ----------------------------------------------------------------
# Create a key at https://console.groq.com/keys and set it only on the server.
# Without it, /api/analyze reports "AI unavailable" and the extension falls
# back to deterministic evidence only (this is a safe degradation).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Google Safe Browsing ---------------------------------------------------
# STRONGLY RECOMMENDED. This is the single highest-signal threat source.
# Get a key at https://console.cloud.google.com/apis/credentials
# (enable "Safe Browsing API").
#
# Without it the extension reports `safeBrowsingStatus: LOOKUP_UNAVAILABLE`
# rather than claiming a site is clean — but you lose malware/phishing
# coverage that no heuristic can replace.
#
# GCSB_API_KEY is accepted as an alias and used if the primary is blank.
GOOGLE_SAFEBROWSING_API_KEY=

# --- Threat feed ------------------------------------------------------------
# Optional. Defaults to the free OpenPhish community feed
# (https://openphish.com/feed.txt), refreshed every 30 minutes in memory.
# Point this at your own feed URL if you have one.
# NOTE: OpenPhish Community Feed is free for non-commercial use; obtain a
# Premium licence or swap providers for commercial deployment.
THREAT_FEED_URL=

# --- CORS / extension origin allowlist --------------------------------------
# Comma-separated list of origins allowed to call the API.
#
# LEAVE EMPTY FOR LOCAL DEVELOPMENT ONLY — an empty value allows any
# chrome-extension:// origin, which is fine on localhost but must be locked
# down before deployment. The extension ID is shown on the extension's
# details page in chrome://extensions.
ALLOWED_EXTENSION_ORIGINS=

# --- Rate limiting ----------------------------------------------------------
# /api/analyze — the expensive endpoint, so it gets the tight budget.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MINUTES=15

# /api/threat-lookup — runs on every page scan, so it needs a much larger
# budget. In-memory caching absorbs most repeats.
THREAT_RATE_LIMIT_MAX=600
THREAT_RATE_LIMIT_WINDOW_MINUTES=15

# --- Logging ----------------------------------------------------------------
# fatal | error | warn | info | debug | trace
# Note: request bodies are never logged.
LOG_LEVEL=info
