{
  "name": "@scamshield/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node20 --outDir dist --clean --sourcemap",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@scamshield/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "openai": "^4.63.0",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "pino-pretty": "^11.2.2",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "5.6.2",
    "typescript-eslint": "8.8.1",
    "vitest": "^2.1.1"
  }
}
