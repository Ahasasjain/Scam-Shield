# Caddy reverse proxy for the ScamShield API (used by the `edge` profile in
# docker-compose.yml).
#
# Caddy obtains and renews Let's Encrypt certificates automatically — no
# certbot, no cron. Requirements:
#   * DOMAIN is set in the root .env (compose passes it through)
#   * a DNS A/AAAA record for DOMAIN points at this server
#   * ports 80 and 443 are reachable (security group / firewall)
#
# To register an ACME account e-mail, prepend a global block:
#   {
#       email you@example.com
#   }

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8787
}
